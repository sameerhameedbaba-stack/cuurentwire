# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the deployment (no trailing slash).
# Local: http://localhost:3000 — Production: https://currentwire.us
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Data mode ───────────────────────────────────────────────────────────
# "mock" = clearly-labeled demo data from fictional outlets (no keys needed)
# "live" = fetch from configured providers below
# Unset  = auto: live when any provider is configured, otherwise mock.
NEWS_DATA_MODE=mock

# How often the news cache refreshes, in minutes (default 5).
# Also the default GNews cadence when GNEWS_REFRESH_MINUTES is unset.
NEWS_REFRESH_MINUTES=5

# RSS fast lane: how often the dataset (and RSS feeds) refresh, in minutes
# (default 15: ~100 curated feeds cost ~2.5s of function CPU per refresh on
# Vercel, and
# the cron skips work when the dataset is younger than this). GNews keeps
# its own slower cadence below.
RSS_REFRESH_MINUTES=15

# How often the GNews layer refreshes, in minutes. Defaults to
# NEWS_REFRESH_MINUTES if set, else 30. Keep >= 30 in production so the
# free tier (100 requests/day, 2 per fetch) is never exceeded.
GNEWS_REFRESH_MINUTES=30

# ── News providers (configure at least one for live mode) ───────────────
# GNews — https://gnews.io (free tier available)
GNEWS_API_KEY=

# NewsAPI.org — https://newsapi.org (free tier is development-only)
NEWS_API_KEY=

# Comma-separated official publisher RSS feed URLs you are permitted to use.
# Example: RSS_FEEDS=https://example.com/rss,https://example.org/feed.xml
RSS_FEEDS=

# Curated official feeds (config/feeds.ts) join RSS_FEEDS automatically
# whenever RSS is on. Set off to use only your RSS_FEEDS; set on to use the
# curated list even with RSS_FEEDS empty.
RSS_CURATED_FEEDS=

# ── Database (optional — the app runs fully without it) ────────────────
# PostgreSQL connection string. Enables durable archiving of articles,
# clusters, ingestion runs and ranking snapshots via the cron endpoint.
DATABASE_URL=

# ── Security ────────────────────────────────────────────────────────────
# Required in production for /api/cron/news-refresh (Bearer token).
CRON_SECRET=

# Required in production to view /admin/status. Visit /admin/auth?key=<value>
# once per browser to set the access cookie (or send an x-admin-key header).
ADMIN_SECRET=

# ── Index quality ───────────────────────────────────────────────────────
# Mature (>72h) single-source stories with no CurrentWire-specific value
# answer noindex,follow (URL stays permanent). Set off to index everything.
THIN_STORY_NOINDEX=

# ── Analytics (optional) ────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Unset = no analytics
# script is loaded and nothing is collected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Contact addresses shown on the site ────────────────────────────────
CONTACT_EMAIL=contact@currentwire.us
CORRECTIONS_EMAIL=corrections@currentwire.us
PUBLISHERS_EMAIL=publishers@currentwire.us
